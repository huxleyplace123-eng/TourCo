# TicoWild customer + operator portals — Supabase config.
# Copy this file to `.env` and paste the two values from your Supabase project
# (Project Settings → API). Without them, the portal runs in demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public concierge contact. Digits only or any normal phone formatting.
# If WhatsApp is blank, public requests fall back to hello@ticowild.com.
VITE_TICOWILD_WHATSAPP=
VITE_TICOWILD_EMAIL=hello@ticowild.com

# Dedicated Gmail account used by every CRM email action. The compose window
# opens in this account so personal Gmail is never used accidentally.
VITE_TICOWILD_GMAIL=ticowildtours@gmail.com
